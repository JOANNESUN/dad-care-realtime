{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dad-care-log",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker gates every request behind the shared password,
    // so no asset may be served before it runs.
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "CARE_ROOM",
        "class_name": "CareRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CareRoom"
      ]
    }
  ]
}
